{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/manifest.json",
      "dest": "/public/manifest.json"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "15 22 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "45 6 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 16 * * *"
    }
  ]
}
